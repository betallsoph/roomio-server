{
	"name": "roomio-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "npm run db:migrate && node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
		"build": "DATABASE_URL=postgres://roomio:build@build.invalid:5432/roomio SESSION_SECRET=build-time-synthetic-secret-32chars-min!! SUPER_ADMIN_ACCOUNTS=build-admin@build.invalid:build-only-random-owner-passphrase ORIGIN=https://build.invalid PUBLIC_APP_ORIGIN=https://app.build.invalid node node_modules/vite/bin/vite.js build",
		"start": "npm run db:migrate && node --env-file-if-exists=.env build/index.js",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format:check": "prettier --check .",
		"test": "node --import tsx --test $(find src/lib/server -name '*.test.ts' | sort)",
		"test:security": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 $(find src/lib/server/authorization src/lib/server/audit src/lib/server/staff src/lib/server/testing src/routes/api/invoices/bulk src/routes/api/invoices/draft-approve \\( -name '*.test.ts' -o -name '*.security.test.ts' \\) 2>/dev/null | sort)",
		"test:telegram": "tsx --test src/lib/server/telegram.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:check": "bash scripts/check-migration-drift.sh",
		"db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
		"cleanup:uploads": "tsx scripts/cleanup-uploads.ts",
		"tenancy:profile": "tsx scripts/profile-tenancy-migration.ts",
		"tenancy:backfill": "tsx scripts/backfill-tenancies.ts",
		"tenancy:reconcile": "tsx scripts/reconcile-tenancy-scope.ts",
		"test:scripts": "node --import tsx --test scripts/*.test.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1073.0",
		"@aws-sdk/s3-request-presigner": "^3.1073.0",
		"@google/generative-ai": "^0.24.1",
		"@upstash/qstash": "2.11.3",
		"bcryptjs": "^2.4.3",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.21.0",
		"pino": "^9.14.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	}
}
