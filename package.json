{
	"name": "roomio-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run db:migrate && node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
		"build": "DATABASE_URL=postgres://roomio:roomio@localhost:5432/roomio node --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
		"start": "npm run db:migrate && node --env-file-if-exists=.env build/index.js",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
		"cleanup:uploads": "tsx scripts/cleanup-uploads.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1073.0",
		"@aws-sdk/s3-request-presigner": "^3.1073.0",
		"bcryptjs": "^2.4.3",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.21.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	}
}
