# Chuỗi kết nối Postgres. Bắt buộc cả local lẫn production.
DATABASE_URL=postgres://roomio:local-dev-only-password@localhost:5432/roomio

# --- DB pool và timeout (INFRA-005) ---
# Để TRỐNG là dùng đúng mặc định đã chốt cho A1 một OCPU; chỉ điền khi cần chỉnh có số đo.
# Ngân sách là 8 connection cho CẢ máy A1-APP, không phải 8 cho mỗi process:
# API_DB_POOL_MAX + DISPATCHER_DB_POOL_MAX phải <= 8, sai thì process từ chối boot.
# Mặc định: API 6, dispatcher 2.
API_DB_POOL_MAX=
DISPATCHER_DB_POOL_MAX=
# Hết hạn chờ lấy connection từ pool, ms. Mặc định 3000.
DB_CONNECTION_TIMEOUT_MS=
# Connection rảnh bị đóng sau bao lâu, ms. Mặc định 30000.
DB_IDLE_TIMEOUT_MS=
# Trần thời gian một câu lệnh, ms. Mặc định 15000, tối đa cho phép 60000.
# Job dài phải chia nhỏ; KHÔNG nới giá trị này để che query chậm.
DB_STATEMENT_TIMEOUT_MS=
# Trần thời gian chờ lock, ms. Mặc định 3000, tối đa cho phép 10000.
DB_LOCK_TIMEOUT_MS=
# Trần thời gian transaction nằm idle, ms. Mặc định 10000.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# Super Admin cố định từ env, không lưu trong DB. Nhiều account vẫn là cùng một admin.
# Format: email:password[:display name],email2:password2[:display name]
SUPER_ADMIN_ACCOUNTS=
# Khóa ký cookie phiên — BẮT BUỘC đổi ở production: openssl rand -base64 48
SESSION_SECRET=change_me_to_a_secure_random_string_in_production
# Khóa bảo vệ endpoint cron /api/cron/monthly (lịch tự nhắc + tự soạn hóa đơn nháp).
# Đặt chuỗi ngẫu nhiên dài: openssl rand -base64 48. Workflow cron.yml đọc thẳng từ .env này.
CRON_SECRET=
# Domain API công khai (webhook PayOS, machine callbacks)
ORIGIN=https://api.roomio.example.com
# Domain frontend công khai (redirect sau thanh toán)
PUBLIC_APP_ORIGIN=https://app.roomio.example.com
# payOS NỀN TẢNG (my.payos.vn -> Kênh thanh toán) — dùng cho phí subscription chủ trọ → SuperAdmin.
# Tiền THUÊ (khách → chủ trọ) KHÔNG dùng các key này; mỗi chủ trọ tự kết nối PayOS riêng trong app.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# API endpoint PayOS; thường không cần đổi.
PAYOS_API_BASE=https://api-merchant.payos.vn
# Khóa AES-256-GCM mã hóa key PayOS RIÊNG của từng chủ trọ trước khi lưu DB.
# BẮT BUỘC khi dùng kết nối PayOS per-landlord: openssl rand -base64 32
PAYOS_ENC_KEY=
# Mã đối tác tích hợp PayOS (tùy chọn) — hoa hồng theo giao dịch; lấy khi ký hợp đồng Đối tác tích hợp.
PAYOS_PARTNER_CODE=
# URL frontend công khai để payOS redirect sau thanh toán/hủy
# Cổng API
PORT=3000

# Cloudflare R2 (S3-compatible) để cấp pre-signed URL cho web/TMA upload ảnh trực tiếp
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domain public/read-only trỏ vào bucket, ví dụ https://assets.roomio.example.com
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRES_SECONDS=300
R2_UPLOAD_MAX_BYTES=5242880

# Google AI Studio — OCR chỉ số đồng hồ điện từ ảnh (Gemini)
GOOGLE_AI_API_KEY=
# Tùy chọn; mặc định gemini-2.5-flash
GEMINI_METER_MODEL=gemini-2.5-flash

# QStash (Upstash) — bật cả bộ hoặc để trống để tắt job machine routes
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Telegram webhook secret (bắt buộc khi bật Telegram ở production)
TELEGRAM_WEBHOOK_SECRET=

# Telegram Mini App (roomio-tma)
# Token bot lấy từ @BotFather — BẮT BUỘC để verify initData và gửi tin nhắn Telegram cho khách
BOT_TOKEN=
# Username bot + short-name Mini App, để dashboard sinh link mời:
#   https://t.me/<BOT_USERNAME>/<MINIAPP_SHORT_NAME>?startapp=<token>
BOT_USERNAME=
MINIAPP_SHORT_NAME=

# Mức log (tùy chọn): debug | info | warn | error. Production mặc định info.
LOG_LEVEL=
# Git SHA đang chạy; workflow deploy tự điền, không đặt cố định bằng tay.
RELEASE_SHA=

# --- Feature flag (AUTH-006) ---
# Bật service ManagedTenant/Tenancy cho check-in/check-out mới (dual-write cache tương thích).
# Để TRỐNG hoặc false = giữ luồng legacy; production chỉ bật SAU khi migration + backfill
# AUTH-007 chạy xong. Giá trị hợp lệ: true/false/1/0/yes/no/on/off; giá trị lạ chặn boot.
TENANCY_DUAL_WRITE_ENABLED=false
